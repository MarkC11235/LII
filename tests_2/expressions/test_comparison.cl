let bool lt1 = 1 < 2;
let bool lt2 = 2 < 1;
let bool lt3 = 1 < 1;

let bool gt1 = 1 > 2;
let bool gt2 = 2 > 1;
let bool gt3 = 1 > 1;

let bool lte1 = 1 <= 2;
let bool lte2 = 2 <= 1;
let bool lte3 = 1 <= 1;

let bool gte1 = 1 >= 2;
let bool gte2 = 2 >= 1;
let bool gte3 = 1 >= 1;

let bool eq1 = 1 == 1;
let bool eq2 = 1 == 2;

let bool neq1 = 1 != 1;
let bool neq2 = 1 != 2;


print "lt1: 1 < 2 = " + lt1;
print "lt2: 2 < 1 = " + lt2;
print "lt3: 1 < 1 = " + lt3;

print "gt1: 1 > 2 = " + gt1;
print "gt2: 2 > 1 = " + gt2;
print "gt3: 1 > 1 = " + gt3;

print "lte1: 1 <= 2 = " + lte1;
print "lte2: 2 <= 1 = " + lte2;
print "lte3: 1 <= 1 = " + lte3;

print "gte1: 1 >= 2 = " + gte1;
print "gte2: 2 >= 1 = " + gte2;
print "gte3: 1 >= 1 = " + gte3;

print "eq1: 1 == 1 = " + eq1;
print "eq2: 1 == 2 = " + eq2;

print "neq1: 1 != 1 = " + neq1;
print "neq2: 1 != 2 = " + neq2;



