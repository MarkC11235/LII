let pretty_print_augmented = func(augmented){
    // print "\nAugmented Matrix:";
    let padding = 22;
    let width = $vector_length(augmented[0]);
    let temp = "--";
    for (let i = 0; i < width * (padding + 1); i = i + 1){
        temp = temp + " ";
    }
    temp = temp + "--";
    print temp;

    for (let i = 0; i < $vector_length(augmented); i = i + 1){
        let temp = "|";
        for (let j = 0; j < $vector_length(augmented[i]); j = j + 1){
            let len = $string_length(augmented[i][j] + "");\
            if (j == $vector_length(augmented[i]) - 1){
                temp = temp + "| ";
                for (let k = 0; k < padding - len; k = k + 1){
                    temp = temp + " ";
                }  
                temp = temp + augmented[i][j] + " |";
                print temp;
            }
            else{
                for (let k = 0; k < padding - len; k = k + 1){
                    temp = temp + " ";
                }
                temp = temp + augmented[i][j] + " ";
            }
        }
    }

    temp = "--";
    for (let i = 0; i < width * (padding + 1); i = i + 1){
        temp = temp + " ";
    }
    temp = temp + "--";
    print temp;

    print "";
    return 0;
};

let augment_matrix = func(A, b){
    let n = $vector_length(b);
    let augmented = [];
    for (let i = 0; i < n; i = i + 1){
        augmented = $vector_push(augmented, $vector_push(A[i], b[i]));
    }

    return augmented;
};

let REF_GE = func(augmented){
    let n = $vector_length(augmented);    
    
    // Helper functions ------------------------------------------
    let scale_row = func(augmented, row, scale){
        for (let i = 0; i < $vector_length(augmented[row]); i = i + 1){
            augmented[row][i] = augmented[row][i] * scale;
        }
        return augmented;
    };

    let add_row = func(augmented, row1, row2, scale){
        for (let i = 0; i < $vector_length(augmented[row1]); i = i + 1){
            augmented[row1][i] = augmented[row1][i] + augmented[row2][i] * scale;
        }
        return augmented;
    };
    // -----------------------------------------------------------

    // Gaussian Elimination
    for(let i = 0; i < n; i = i + 1){
        // Scale A[i][i] to 1
        if (augmented[i][i] == 0){
            print "Error: Division by zero";
            return null;
        }
        let scale = 1 / augmented[i][i];
        augmented = scale_row(augmented, i, scale);

        // Eliminate all elements below A[i][i]
        for(let j = i + 1; j < n; j = j + 1){
            let scale = -augmented[j][i];
            augmented = add_row(augmented, j, i, scale);
        }
    }

    return augmented;
};

let REF_GE_partial_pivoting = func(augmented){
    let n = $vector_length(augmented);    
    
    // Helper functions ------------------------------------------
    let scale_row = func(augmented, row, scale){
        for (let i = 0; i < $vector_length(augmented[row]); i = i + 1){
            augmented[row][i] = augmented[row][i] * scale;
        }
        return augmented;
    };

    let add_row = func(augmented, row1, row2, scale){
        for (let i = 0; i < $vector_length(augmented[row1]); i = i + 1){
            augmented[row1][i] = augmented[row1][i] + augmented[row2][i] * scale;
        }
        return augmented;
    };

    let swap_rows = func(augmented, row1, row2){
        let temp = augmented[row1];
        augmented[row1] = augmented[row2];
        augmented[row2] = temp;
        return augmented;
    };

    let abs = func(x){if (x < 0){return -x;} return x;};
    // -----------------------------------------------------------

    // Gaussian Elimination
    for(let i = 0; i < n; i = i + 1){
        // check rows from i to n-1 for the largest element in the i-th column
        let max = augmented[i][i];
        let max_row = i;
        for(let j = i + 1; j < n; j = j + 1){
            if (abs(augmented[j][i]) > abs(max)){
                max = augmented[j][i];
                max_row = j;
            }
        }

        // swap rows i and max_row
        if (max_row != i){
            augmented = swap_rows(augmented, i, max_row);
        }

        if (augmented[i][i] == 0){
            print "Error: Division by zero";
            return null;
        }

        // Scale A[i][i] to 1
        let scale = 1 / augmented[i][i];
        augmented = scale_row(augmented, i, scale);

        // Eliminate all elements below A[i][i]
        for(let j = i + 1; j < n; j = j + 1){
            let scale = -augmented[j][i];
            augmented = add_row(augmented, j, i, scale);
        }
    }

    return augmented;
};

let REF_GE_partial_pivoting_row_interchanging_vector = func(augmented){
    let n = $vector_length(augmented);    
    
    // Helper functions ------------------------------------------
    let scale_row = func(augmented, row, scale){
        for (let i = 0; i < $vector_length(augmented[row]); i = i + 1){
            augmented[row][i] = augmented[row][i] * scale;
        }
        return augmented;
    };

    let add_row = func(augmented, row1, row2, scale){
        for (let i = 0; i < $vector_length(augmented[row1]); i = i + 1){
            augmented[row1][i] = augmented[row1][i] + augmented[row2][i] * scale;
        }
        return augmented;
    };

    let abs = func(x){if (x < 0){return -x;} return x;};
    // -----------------------------------------------------------

    let row_interchanging_vector = [];
    for(let i = 0; i < n; i = i + 1){
        row_interchanging_vector = $vector_push(row_interchanging_vector, i);
    }

    // Gaussian Elimination
    for(let i = 0; i < n; i = i + 1){
        // check rows from i to n-1 for the largest element in the i-th column
        let max = augmented[row_interchanging_vector[i]][i];
        let max_row = i;
        for(let j = i + 1; j < n; j = j + 1){
            if (abs(augmented[row_interchanging_vector[j]][i]) > abs(max)){
                max = augmented[row_interchanging_vector[j]][i];
                max_row = j;
            }
        }

        // swap rows i and max_row
        if (max_row != i){
            let temp = row_interchanging_vector[i];
            row_interchanging_vector[i] = row_interchanging_vector[max_row];
            row_interchanging_vector[max_row] = temp;
        }

        if (augmented[row_interchanging_vector[i]][i] == 0){
            print "Error: Division by zero";
            return null;
        }

        // Scale A[i][i] to 1
        let scale = 1 / augmented[row_interchanging_vector[i]][i];
        augmented = scale_row(augmented, row_interchanging_vector[i], scale);

        // Eliminate all elements below A[i][i]
        for(let j = i + 1; j < n; j = j + 1){
            let scale = -augmented[row_interchanging_vector[j]][i];
            augmented = add_row(augmented, row_interchanging_vector[j], row_interchanging_vector[i], scale);
        }

    }

    return [augmented, row_interchanging_vector];
};

let RREF_GE = func(augmented){
    let n = $vector_length(augmented);

    // Helper functions ------------------------------------------
    let scale_row = func(augmented, row, scale){
        for (let i = 0; i < $vector_length(augmented[row]); i = i + 1){
            augmented[row][i] = augmented[row][i] * scale;
        }
        return augmented;
    };

    let add_row = func(augmented, row1, row2, scale){
        for (let i = 0; i < $vector_length(augmented[row1]); i = i + 1){
            augmented[row1][i] = augmented[row1][i] + augmented[row2][i] * scale;
        }
        return augmented;
    };
    // -----------------------------------------------------------

    // Gaussian Elimination
    for(let i = 0; i < n; i = i + 1){
        if (augmented[i][i] == 0){
            print "Error: Division by zero";
            return null;
        }
        // Scale A[i][i] to 1
        let scale = 1 / augmented[i][i];
        augmented = scale_row(augmented, i, scale);

        // Eliminate all elements in the column
        for(let j = 0; j < n; j = j + 1){
            if (j != i){
                let scale = -augmented[j][i];
                augmented = add_row(augmented, j, i, scale);
            }
        }
    }

    return augmented;
};

let Back_Substitution = func(REF_augmented){
    let n = $vector_length(REF_augmented); // n: 3
    let x = [];

    for (let i = n - 1; i >= 0; i = i - 1){ // i: 2, 1, 0
        let sum = REF_augmented[i][n]; // gets value from b
        for(let j = 0; j < n - 1 - i; j = j + 1){ // i = 2, j: X; i = 1, j: 0; i = 0, j: 0, 1
            sum = sum - REF_augmented[i][n - 1 - j] * x[j];
        }
        x = $vector_push(x, sum); // Asssumes that diagonal entries are 1
    }

    x = $vector_reverse(x); // to put x as, x_0, x_1, x_2, ...
    return x;
};

let Back_Substitution_row_interchanging_vector = func(REF_augmented, row_interchanging_vector){
    let n = $vector_length(REF_augmented); // n: 3
    let x = [];

    for (let i = n - 1; i >= 0; i = i - 1){ // i: 2, 1, 0
        let sum = REF_augmented[row_interchanging_vector[i]][n]; // gets value from b
        for(let j = 0; j < n - 1 - i; j = j + 1){ // i = 2, j: X; i = 1, j: 0; i = 0, j: 0, 1
            sum = sum - REF_augmented[row_interchanging_vector[i]][n - 1 - j] * x[j];
        }
        x = $vector_push(x, sum); // Asssumes that diagonal entries are 1
    }

    x = $vector_reverse(x); // to put x as, x_0, x_1, x_2, ...
    return x;
};

let determinant = func(A){
    let minor = func(A, row, col){
        let sub = [];
        for(let i = 0; i < $vector_length(A); i = i + 1){
            if(i == row){continue;}
            let temp = [];
            for(let j = 0; j < $vector_length(A); j = j + 1){
                if(j == col){continue;}
                temp = $vector_push(temp, A[i][j]);
            }
            sub = $vector_push(sub, temp);
        }
        return sub;
    };

    let determinant_2x2 = func(A){return A[0][0] * A[1][1] - A[0][1] * A[1][0];};

    // Expect square matrix
    let n = $vector_length(A);

    if(n == 2){
        return determinant_2x2(A);
    }
    
    let det = 0;
    for(let i = 0; i < n; i = i + 1){
        let m = minor(A, 0, i);
        if(i % 2 == 0){
            det = det + A[0][i] * determinant(m);
        }
        else{
            det = det - A[0][i] * determinant(m);
        }
    }

    return det;
};

let norm = func(vector, type){
    let abs = func(x){if (x < 0){return -x;} return x;};
    let n = $vector_length(vector);
    
    if(type == "1"){
        let sum = 0;
        for(let i = 0; i < n; i = i + 1){
            sum = sum + abs(vector[i]);
        }
        return sum;
    }
    if(type == "2"){
        let sum = 0;
        for(let i = 0; i < n; i = i + 1){
            sum = sum + vector[i] * vector[i];
        }
        return $sqrt(sum);
    }
    if(type == "inf"){
        let max = abs(vector[0]);
        for(let i = 1; i < n; i = i + 1){
            if(abs(vector[i]) > max){
                max = abs(vector[i]);
            }
        }
        return max;
    }

    print "Error: Invalid norm type";
    return -1;
};

let matrix_vector_multiplication = func(A, b){
    if($vector_length(A[0]) != $vector_length(b)){
        print "Error: Incompatible dimensions";
        return null;
    }
    
    let n = $vector_length(b);
    let m = $vector_length(A);
    let result = [];
    for(let i = 0; i < m; i = i + 1){
        let sum = 0;
        for(let j = 0; j < n; j = j + 1){
            sum = sum + A[i][j] * b[j];
        }
        result = $vector_push(result, sum);
    }

    return result;
};

